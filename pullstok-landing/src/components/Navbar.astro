---
import Logo from "@/components/Logo.astro";
import { DEMO_WHATSAPP_URL } from "@/consts";

const APP_URL = "https://app.pullstok.com";

const links = [
  { href: "#caracteristicas", label: "Características" },
  { href: "#atencion", label: "IA & Chat" },
  { href: "#como-funciona", label: "Cómo funciona" },
  { href: "#precios", label: "Precios" },
  { href: "#faq", label: "FAQ" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="sticky top-0 z-50 w-full px-3 pt-3 sm:px-6">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 rounded-2xl border border-border bg-card/90 px-4 py-2.5 shadow-[0_8px_24px_-16px_rgba(15,23,42,0.25)] backdrop-blur-md sm:px-5"
    aria-label="Navegación principal"
  >
    <a href="#" class="shrink-0" aria-label="Pullstok, ir al inicio">
      <Logo class="h-7" />
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-lg px-4 py-2 text-sm font-semibold text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden items-center gap-2 md:flex">
      <button
        type="button"
        data-theme-toggle
        aria-label="Cambiar tema claro/oscuro"
        class="flex h-10 w-10 items-center justify-center rounded-xl border border-border text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
      >
        <!-- Sol (visible en modo oscuro) -->
        <svg
          data-theme-icon="sun"
          class="hidden h-5 w-5 dark:block"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <!-- Luna (visible en modo claro) -->
        <svg
          data-theme-icon="moon"
          class="h-5 w-5 dark:hidden"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a
        href={APP_URL}
        class="rounded-lg px-4 py-2 text-sm font-semibold text-muted-foreground transition-colors hover:text-foreground"
      >
        Ingresar
      </a>
      <a href={DEMO_WHATSAPP_URL} class="btn btn-primary h-10 px-5 text-sm">Pedí acceso</a>
    </div>

    <!-- Toggle mobile -->
    <details class="relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-xl border border-border [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="4" x2="20" y1="6" y2="6"></line><line
            x1="4"
            x2="20"
            y1="12"
            y2="12"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
        >
      </summary>
      <div
        class="absolute right-0 top-12 flex w-60 flex-col gap-1 rounded-2xl border border-border bg-card p-2.5 shadow-xl"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class="rounded-lg px-3 py-2.5 text-sm font-semibold text-foreground hover:bg-secondary"
            >
              {link.label}
            </a>
          ))
        }
        <button
          type="button"
          data-theme-toggle
          class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-semibold text-foreground hover:bg-secondary"
        >
          <!-- Sol (visible en modo oscuro) -->
          <svg
            data-theme-icon="sun"
            class="h-5 w-5 dark:block hidden"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <!-- Luna (visible en modo claro) -->
          <svg
            data-theme-icon="moon"
            class="h-5 w-5 dark:hidden"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          Cambiar tema
        </button>
        <hr class="my-1 border-border" />
        <a
          href={APP_URL}
          class="rounded-lg px-3 py-2.5 text-sm font-semibold text-foreground hover:bg-secondary"
        >
          Ingresar
        </a>
        <a href={DEMO_WHATSAPP_URL} class="btn btn-primary mt-1 h-11 w-full text-sm">
          Pedí acceso
        </a>
      </div>
    </details>
  </nav>
</header>

<script is:inline>
  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (e) {}
    });
  });
</script>

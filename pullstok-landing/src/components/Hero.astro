---
import { DEMO_WHATSAPP_URL } from "../consts";
---

<section class="relative overflow-hidden px-4 pt-10 pb-16 sm:px-6 sm:pt-16 sm:pb-24 lg:px-8">
  <!-- Fondo: grilla sutil (utilitario definido en global.css) -->
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="bg-grid-fade pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40" aria-hidden="true"></div>

  <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-10">
    <!-- Columna texto -->
    <div class="text-center lg:text-left">
      <span class="badge mb-6 bg-accent text-accent-foreground">
        Gestión, stock y facturación para tu negocio
      </span>

      <h1 class="text-[2.7rem] font-bold leading-[1.05] text-foreground sm:text-6xl lg:text-[4.25rem]">
        Tu negocio,<br />con control total
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-lg text-muted-foreground sm:text-xl lg:mx-0">
        Pullstok centraliza el stock, las ventas, la facturación y tu tienda
        online en un solo sistema. Tomá decisiones con datos reales y hacé
        crecer tu comercio o pyme sin fricción.
      </p>

      <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row lg:items-start lg:justify-start">
        <a href={DEMO_WHATSAPP_URL} class="btn btn-primary w-full sm:w-auto">
          Pedí acceso al demo
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#caracteristicas" class="btn btn-outline w-full sm:w-auto">
          Ver el producto
        </a>
      </div>

      <div class="mt-6 flex items-center justify-center gap-2 text-sm font-medium text-muted-foreground lg:justify-start">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M20 6 9 17l-5-5"/></svg>
        Escribinos por WhatsApp y te habilitamos el acceso
      </div>
    </div>

    <!-- Columna visual: app en un marco + tarjetas flotantes -->
    <div class="relative mx-auto w-full max-w-md lg:mx-0 lg:max-w-none">
      <!-- Marco tipo app con indicadores -->
      <div class="card-pop relative aspect-[4/5] overflow-hidden rounded-2xl bg-card p-0">
        <div class="flex items-center gap-2 border-b border-border bg-muted/70 px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-destructive" />
          <span class="h-3 w-3 rounded-full bg-warning" />
          <span class="h-3 w-3 rounded-full bg-success" />
          <span class="ml-3 flex-1 truncate rounded-full bg-card px-3 py-1 text-xs font-medium text-muted-foreground">
            app.pullstok.com
          </span>
        </div>
        <img
          src="/images/comerciante.jpg"
          alt="Comerciante gestionando su negocio con Pullstok"
          width="1000"
          height="1250"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>

      <!-- Tarjeta flotante: ventas de hoy -->
      <div class="card card-pop absolute -left-4 top-10 w-44 gap-1 p-4 sm:-left-8">
        <p class="text-xs font-semibold text-muted-foreground">Ventas de hoy</p>
        <p class="font-display text-2xl font-bold text-foreground">$184.350</p>
        <p class="flex items-center gap-1 text-xs font-bold text-success">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
          +12% vs. ayer
        </p>
      </div>

      <!-- Tarjeta flotante: stock crítico -->
      <div class="card card-pop absolute -bottom-5 -right-3 w-48 gap-1 p-4 sm:-right-6">
        <p class="text-xs font-semibold text-muted-foreground">Stock crítico</p>
        <p class="font-display text-2xl font-bold text-foreground">7 ítems</p>
        <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-muted">
          <div class="h-full w-2/3 rounded-full bg-warning"></div>
        </div>
      </div>

      <!-- Pin "tienda online activa" -->
      <div class="badge absolute -top-3 right-6 bg-accent text-accent-foreground shadow-[0_8px_20px_-12px_rgba(15,23,42,0.4)]">
        Tienda online activa
      </div>
    </div>
  </div>
</section>

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7: la conexión va en prisma.config.ts (migrate) y en el driver
  // adapter del PrismaClient (runtime). Ya no se declara `url` acá.
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  MANAGEMENT
  VENDEDOR
  CASHIER
  EMPLOYEE
}

enum Industry {
  FERRETERIA
  KIOSCO
  INDUMENTARIA
  ALMACEN
  OTHER
}

enum Plan {
  BASICO
  PRO
  PREMIUM
}

// Tipo de layout de la planilla de precios del proveedor Alican
// (sdd/alican-wholesale-price-list).
enum PriceListType {
  SECO
  WET
}

// Medio de pago de una venta (sdd/caja-apertura-cierre). Solo EFECTIVO suma al
// arqueo de caja (closingByMethod/expectedAmount); TARJETA_*/TRANSFERENCIA/QR
// son informativos del desglose (no son efectivo en caja física).
enum PaymentMethod {
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA
  QR
}

// Estado de una sesión de caja (sdd/caja-apertura-cierre). OPEN = turno en
// curso; CLOSED = cerrada con arqueo. Una sola OPEN por sucursal (branch) se
// garantiza en DB vía el índice único parcial `cash_session_single_open`
// (agregado a mano en la migración, NO regenerable por Prisma).
enum CashSessionStatus {
  OPEN
  CLOSED
}

// El tenant: cada negocio que compra el ERP es una Organization.
model Organization {
  id                    String      @id @default(uuid())
  name                  String
  slug                  String      @unique
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())
  address               String?
  phone                 String?
  taxId                 String?
  industry              Industry    @default(OTHER)
  onboardingCompletedAt DateTime?
  plan                  Plan        @default(BASICO)
  paidUntil             DateTime?
  taxCondition          String?
  // Datos fiscales del emisor para la factura estándar (Ingresos Brutos e
  // Inicio de Actividades se muestran debajo del CUIT en el comprobante ARCA).
  ingresosBrutos        String?
  inicioActividades     String?
  // Módulos habilitados por negocio (sdd/modulos-por-negocio). Array vacío =
  // "no configurado" → el front cae al comportamiento legacy por plan + suelto
  // condicional (ver resolveEffectiveModules en config/planLimits.ts).
  enabledModules        String[]    @default([])
  users                 User[]
  products              Product[]
  providers             Provider[]
  priceKgTypes          PriceKgType[]
  priceKgBrands         PriceKgBrand[]
  priceKgPrices         PriceKgPrice[]
  categories            Category[]
  variantDefs           CategoryVariantDefinition[]
  variantOptions        CategoryVariantOption[]
  productVariants       ProductVariant[]
  customers             Customer[]
  orders                Order[]
  quotations            Quotation[]
  sales                 Sale[]
  receipts              Receipt[]
  counters              Counter[]
  storeSettings         StoreSettings?
  invoices              Invoice[]
  conversations         Conversation[]
  botConfig             BotConfig?
  appBranding           AppBranding?
  arcaSetting           ArcaSetting?
  arcaSequences         ArcaSequence[]
  branches              Branch[]
  productStocks         ProductStock[]
  looseStocks           LooseStock[]
  businessHours         BusinessHourSetting?
  pricingSetting        PricingSetting?
  priceLists            PriceList[]
  reviewQueueEntries    ReviewQueueEntry[]
  cashSessions          CashSession[]
  whatsAppOrderDrafts   WhatsAppOrderDraft[]

  @@map("organizations")
}

model User {
  id                 String        @id @default(uuid())
  email              String?       @unique
  username           String?       @unique
  name               String?
  phone              String?
  address            String?
  password           String
  role               Role          @default(EMPLOYEE)
  mustChangePassword Boolean       @default(true)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  // null SOLO para el SUPERADMIN (la plataforma). Todo otro usuario pertenece a una org.
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])
  // Password recovery: hashed reset token + expiry (nullable, null by default).
  resetToken         String?
  resetTokenExpiry   DateTime?
  branchAssignments  BranchAssignment[]
  cashSessions       CashSession[]

  @@index([organizationId])
  @@map("users")
}

model Branch {
  id             String             @id @default(uuid())
  name           String
  address        String?
  phone          String?
  isActive       Boolean            @default(true)
  // Casa central: la DB garantiza EXACTAMENTE 1 por organización vía el
  // índice único parcial "branch_single_headquarters" (ver migración).
  isHeadquarters Boolean            @default(false)
  // Punto de venta fiscal ARCA de la sucursal (sdd/sucursales-pv-facturacion).
  // Opcional: null → la emisión cae al fallback (casa central / PV global de
  // ArcaSetting, ver resolvePuntoVenta en fiscalInvoiceService). La unicidad
  // entre sucursales ACTIVAS de una misma org se garantiza con el índice
  // parcial raw "branch_active_puntoVenta" (a mano en la migración).
  puntoVenta     Int?
  createdAt      DateTime           @default(now())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  assignments    BranchAssignment[]
  stocks         ProductStock[]
  looseStocks    LooseStock[]
  storeSettings  StoreSettings[]
  sales          Sale[]
  orders         Order[]
  quotations     Quotation[]
  cashSessions   CashSession[]
  invoices       Invoice[]          @relation("InvoiceBranch")

  @@unique([organizationId, name])
  @@map("branches")
}

model BranchAssignment {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("branch_assignments")
}

model Customer {
  id             String       @id @default(uuid())
  name           String
  email          String
  phone          String?
  taxId          String?
  taxCondition   String?
  address        String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orders         Order[]
  quotations     Quotation[]
  invoices       Invoice[]
  conversations  Conversation[]
  whatsAppOrderDrafts WhatsAppOrderDraft[]

  // Email único POR organización (dos negocios pueden tener el mismo cliente).
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("customers")
}

model Category {
  id             String                       @id @default(uuid())
  name           String
  parentId       String?
  parent         Category?                    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]                   @relation("CategoryHierarchy")
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id])
  products       Product[]
  variantDefs    CategoryVariantDefinition[]

  @@unique([organizationId, parentId, name])
  @@map("categories")
}

model CategoryVariantDefinition {
  id             String                   @id @default(uuid())
  categoryId     String
  category       Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int                      @default(0)
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  options        CategoryVariantOption[]

  @@unique([categoryId, name])
  @@map("category_variant_definitions")
}

model CategoryVariantOption {
  id              String                        @id @default(uuid())
  variantId       String
  variant         CategoryVariantDefinition     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value           String
  sortOrder       Int                           @default(0)
  organizationId  String
  organization    Organization                  @relation(fields: [organizationId], references: [id])
  productVariants ProductVariant[]

  @@unique([variantId, value])
  @@map("category_variant_options")
}

model ProductVariant {
  id             String                @id @default(uuid())
  productId      String
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionId       String
  option         CategoryVariantOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id])

  @@unique([productId, optionId])
  @@map("product_variants")
}

// Un proveedor de la organización (ej. "ALICAN"). Tenant-scoped (organizationId)
// y en TENANT_MODELS (db.ts) → scope org automático anti-fuga. Los productos
// tocados por una planilla de precios (sdd/alican-wholesale-price-list/providers)
// quedan asociados al proveedor elegido al importar, para filtrar por proveedor
// en la actualización masiva de precios. El código SIEMPRE resuelve por nombre
// con findFirst case-insensitive y crea si no existe (nunca findUnique —
// bloqueado por la extensión multi-tenant). La unicidad (org, name) es
// case-insensitive a nivel DB: la migración materializa la @@unique de abajo
// como índice funcional LOWER (misma desviación intencional que el índice
// parcial de price_lists).
model Provider {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("providers")
}

// Especie a la que aplica un tipo/marca de "Precios por kilo" (sdd/price-kg-plan).
// PERRO | GATO | AMBOS (aplica a ambas planillas). La planilla se edita por
// especie (matriz Perros vs Gatos), por eso cada tipo/marca declara su especie.
enum Species {
  PERRO
  GATO
  AMBOS
}

// Tipos de "Precios por kilo" (etapas de vida del alimento: Adulto, Cachorro,
// Kitten, Senior, etc.). Tenant-scoped (organizationId) y en TENANT_MODELS
// (db.ts) → scope org automático anti-fuga. `synonyms` se mantiene por
// compatibilidad con el CRUD; ya no se usa para matchear nombres de producto
// (la planilla editora usa el tipo como columna de la matriz, no propaga a
// productos). La unicidad (org, name) es case-insensitive a nivel DB: la
// migración materializa la @@unique como índice funcional LOWER (mismo patrón
// intencional que providers y price_lists).
model PriceKgType {
  id             String         @id @default(uuid())
  name           String
  synonyms       String[]
  // Orden de aparición en la planilla (matriz). Default alto → los tipos
  // nuevos caen al final; se asigna 10, 20, 30... para dejar espacio entre
  // inserciones. listPriceKgTypes ordena por sortOrder asc, name asc.
  sortOrder      Int            @default(1000)
  // Especie de la planilla a la que aplica (PERRO/GATO/AMBOS). Default PERRO:
  // los registros legacy caen en la planilla de perros sin datos que migrar.
  species        Species        @default(PERRO)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  priceKgPrices  PriceKgPrice[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("price_kg_types")
}

// Marcas de "Precios por kilo" (líneas/sabores editables por el usuario:
// MAXXIUM CORDERO, OLD PRINCE PREMIUM, MASTER RP, ...). Tenant-scoped
// (organizationId) y en TENANT_MODELS (db.ts) → scope org automático
// anti-fuga. `keywords` se mantiene por compatibilidad con el CRUD; ya no se
// usa para matchear nombres de producto (la planilla editora usa la marca como
// fila de la matriz, no propaga a productos). La unicidad (org, name) es
// case-insensitive a nivel DB: la migración materializa la @@unique como
// índice funcional LOWER (mismo patrón que price_kg_types y providers).
model PriceKgBrand {
  id             String         @id @default(uuid())
  name           String
  keywords       String[]
  // Especie de la planilla a la que aplica (PERRO/GATO/AMBOS). Default PERRO:
  // las marcas legacy caen en la planilla de perros sin datos que migrar.
  species        Species        @default(PERRO)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  priceKgPrices  PriceKgPrice[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("price_kg_brands")
}

// Celda de la planilla "Precios por kilo": un precio por kilo para un par
// (marca × tipo) POR especie. La planilla es una matriz marca (filas) × tipo
// (columnas) → precio y se edita por especie (Perros/Gatos), así que cada
// planilla maneja precios individuales: Agility+Adulto Perro ≠ Agility+Adulto
// Gato (una marca y un tipo AMBOS pueden tener precios distintos por especie).
// Tenant-scoped (organizationId) y en TENANT_MODELS (db.ts) → scope org
// automático anti-fuga. La unicidad es (organizationId, brandId, typeId,
// species): a lo sumo una celda por par marca+tipo por especie en la org. No
// matchea nombres de producto: la venta suelta es un tema aparte y no se toca
// desde acá.
model PriceKgPrice {
  id             String       @id @default(uuid())
  brandId        String
  brand          PriceKgBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  typeId         String
  type           PriceKgType  @relation(fields: [typeId], references: [id], onDelete: Cascade)
  // Especie de la planilla a la que pertenece la celda (PERRO/GATO). Default
  // PERRO: las 140 celdas legacy caen en la planilla de perros sin migrar.
  species        Species      @default(PERRO)
  priceKg        Float
  // Código interno de balanza (PLU Systel Cuora) de la celda. Es la llave que
  // une la etiqueta de la balanza con la celda suelta: la balanza imprime el
  // EAN-13 (20 + scaleCode + peso en gramos + verificador) y el POS al escanear
  // extrae scaleCode, encuentra la celda y calcula peso × priceKg. null = sin
  // código (celda sin balanza).
  scaleCode      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reviewQueueEntries ReviewQueueEntry[]
  looseStocks    LooseStock[]
  saleItems      SaleItem[]

  @@unique([organizationId, brandId, typeId, species])
  @@index([organizationId])
  @@index([organizationId, scaleCode])
  @@map("price_kg_prices")
}

// Estado de la cola de revisión de precios por kilo (sdd/precios-suelto-planilla).
// PENDING = esperando decisión del admin; APPROVED/REJECTED = resuelta. NO se
// auto-dismiss: las entradas quedan PENDING hasta que el admin actúa.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Motivo por el que una entrada cae en la cola de revisión en vez de
// auto-aplicarse:
// - FUZZY_MATCH: marca o etapa matcheó con Levenshtein ≤ 2 (typo/alias).
// - MANUAL_OVERRIDE: el producto tiene priceKgSueltoManual=true — NUNCA se
//   auto-matchea, su precio queda intacto y pasa a revisión.
// - ORPHAN_CELL: celda de planilla sin ningún producto matcheado.
// - BRAND_NO_PLANILLA: marca/etapa resuelta sin celda de planilla para esa
//   combinación (marca sin planilla correspondiente).
enum ReviewReason {
  FUZZY_MATCH
  MANUAL_OVERRIDE
  ORPHAN_CELL
  BRAND_NO_PLANILLA
}

// Entrada de la cola de revisión del motor de matching planilla ↔ productos
// (sdd/precios-suelto-planilla). Tenant-scoped (organizationId) y en
// TENANT_MODELS (db.ts) → scope org automático anti-fuga. productId null =
// celda huérfana (sin producto); priceKgPriceId null = sin celda (ej.
// MANUAL_OVERRIDE sin celda que matchee). oldPriceKg = snapshot del precio
// ANTES de aprobar; newPriceKg = precio de la celda a aplicar. Usar
// findFirst/updateMany (nunca findUnique/update) per convención multi-tenant.
model ReviewQueueEntry {
  id             String        @id @default(uuid())
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id])
  priceKgPriceId String?
  priceKgPrice   PriceKgPrice? @relation(fields: [priceKgPriceId], references: [id])
  brandId        String?
  typeId         String?
  species        Species
  reason         ReviewReason
  status         ReviewStatus  @default(PENDING)
  appliedAt      DateTime?
  reviewedBy     String? // userId del revisor
  oldPriceKg     Float? // snapshot antes de aprobar
  newPriceKg     Float? // precio de la celda a aplicar
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("review_queue_entries")
}

model Product {
  id                 String            @id @default(uuid())
  name               String
  price              Float
  code               String?           // Código de barras / SKU del proveedor
  barcode             String?           // EAN-13 / UPC escaneado
  description        String?
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id])
  image              String?
  quantity           Int
  // ── Venta de alimento suelto (sdd/venta-alimento-suelto) ──
  // Precio por kg CONGELADO (B-01/B-04): se calcula en recompute
  // (priceKgSuelto = round2(price/weightKg × effectiveFactor)) y se guarda.
  // La venta SIEMPRE usa el valor almacenado, nunca el factor en vivo.
  // null = producto NO elegible para venta suelta (isLooseEligible=false).
  priceKgSuelto      Float?
  // priceKgSueltoManual: true = priceKgSuelto was set by hand (PUT with a
  // numeric priceKgSuelto) and the recompute must NOT overwrite it. false
  // (default) = priceKgSuelto is derived by recompute and can be overwritten.
  priceKgSueltoManual  Boolean           @default(false)
  // Override por producto del factor org (null = usa el default de la org,
  // que nace en PricingSetting.bulkFactor = 1.20).
  bulkFactor         Float?
  // Peso del envase/bolsa en kg (entrada del backfill o del admin).
  weightKg           Float?
  // Cuántas unidades vienen por caja/pack (sdd/venta-por-unidad-multpack).
  // null = producto NO multi-pack (box-only, comportamiento legacy). Un
  // producto es vendible "por unidad" SOLO cuando unitsPerBox > 1 y no null.
  // Se deriva del nombre (regex "NxG") en el backfill o se edita a mano.
  unitsPerBox        Int?
  // Visibilidad en la tienda online pública (negocio.pullstok.com). Default
  // false: un producto nunca aparece publicado sin que el dueño lo decida.
  publishedToStore   Boolean           @default(false)
  // ¿El negocio trabaja (vende en mostrador) este producto? Es un marcador
  // EXTRA que el admin marca/desmarca incrementalmente; NO borra nada del
  // catálogo. Default false: los productos arrancan "no marcados" y el admin
  // activa los que trabaja. El filtro "solo lo que trabajo" (admin + vendedor)
  // acota la búsqueda a los marcados SOLO cuando se enciende; apagado muestra
  // todo el catálogo.
  carried            Boolean           @default(false)
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id])
  orderItems         OrderItem[]
  quotationItems     QuotationItem[]
  saleItems          SaleItem[]
  variantAssignments ProductVariant[]
  stocks             ProductStock[]
  // Precio mayorista sugerido (import Alican, sdd/alican-wholesale-price-list):
  // init = round2(Con IVA × 1.3334) al importar; ajustable masivamente después.
  // Decimal nullable; product.price NUNCA se toca (el precio del proveedor es
  // solo informativo).
  suggestedPrice     Decimal?           @db.Decimal(12, 2)
  priceListEntries   PriceListEntry[]
  // Proveedor que abastece el producto (sdd/alican-wholesale-price-list/providers).
  // null = sin proveedor (productos legacy). onDelete SetNull: borrar un
  // proveedor NO borra productos, solo les deja el providerId null (mismo
  // criterio que products.categoryId). El import de una planilla lo asigna a
  // todos los productos tocados (matcheados + creados).
  providerId         String?
  provider           Provider?          @relation(fields: [providerId], references: [id], onDelete: SetNull)
  reviewQueueEntries ReviewQueueEntry[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, code])
  @@index([organizationId, barcode])
  @@index([organizationId, providerId])
  @@map("products")
}

// Stock por sucursal (branch-stock). Una fila por par (producto, sucursal).
// Tenant-scoped: está en TENANT_MODELS (db.ts) → scope org automático en los
// endpoints. En el cliente extendido NO se permite findUnique/upsert (patrón
// del codebase) → findFirst / updateMany / create. Product.quantity queda como
// columna legacy sincronizada con el stock de la casa central (spec D4).
model ProductStock {
  id             String       @id @default(uuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // Float (sdd/venta-alimento-suelto B-06, deviation user-confirmed): el stock
  // de sucursal debe poder bookkeep fracciones de kg (vender 2.35 de 10.0 →
  // 7.65). Product.quantity (legacy, casa central) SIGUE Int.
  quantity       Float        @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([productId, branchId])
  @@index([branchId])
  @@map("product_stocks")
}

// Stock de alimento SUELTO por línea de la planilla (celda PriceKgPrice) y por
// sucursal (sdd/loose-lines-stock). Se carga abriendo una bolsa (openBag): se
// descuenta 1 unidad de ProductStock (bolsa en kg) y se acredita weightKg en
// esta tabla. La venta POR_PESO/POR_MONTO descuenta de acá en lugar del stock
// de bolsas. Tenant-scoped (organizationId) y en TENANT_MODELS (db.ts) → scope
// org automático anti-fuga; dentro del $transaction el orgId se pasa EXPLÍCITO.
// Una fila por par (celda, sucursal) → @@unique. Float (kg fraccionarios).
model LooseStock {
  id             String       @id @default(uuid())
  priceKgPriceId String
  priceKgPrice   PriceKgPrice @relation(fields: [priceKgPriceId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity       Float        @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([priceKgPriceId, branchId])
  @@index([branchId])
  @@map("loose_stocks")
}

model Order {
  id             String       @id @default(uuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  totalAmount    Float
  status         OrderStatus  @default(PENDING)
  type           OrderType
  // Canal de origen: STORE (tienda online pública) vs INTERNAL (ERP). Default
  // INTERNAL para que las filas/flujos existentes no cambien de comportamiento.
  source         OrderSource  @default(INTERNAL)
  quotationId    String?
  quotation      Quotation?   @relation(fields: [quotationId], references: [id])
  receipt        String?
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Puente Order→Sale: una Order de la tienda se cierra creando una Sale desde
  // el ERP. Opcional (Orders de compra/internas pueden no tener Sale asociada).
  sale           Sale?
  // Branch scoping: nullable para backward-compat (existing rows = null = org-wide).
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  // Puente a los borradores de WhatsApp que generaron este pedido (FASE 3,
  // approveDraft). En la práctica es 1:1 pero el schema lo modela como lista
  // porque orderId NO es unique en la migración (la FK queda sin constraint).
  whatsAppOrderDrafts WhatsAppOrderDraft[]

  @@index([organizationId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@map("order_items")
}

model Quotation {
  id             String          @id @default(uuid())
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  items          QuotationItem[]
  totalAmount    Float
  validUntil     DateTime
  createdAt      DateTime        @default(now())
  receipt        String?
  orders         Order[]
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  // Branch scoping: nullable para backward-compat (existing rows = null = org-wide).
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id])

  @@index([organizationId])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  price       Float

  @@map("quotation_items")
}

model Sale {
  id             String       @id @default(uuid())
  items          SaleItem[]
  totalAmount    Float
  // Descuento aplicado a la venta en $ (sdd/venta-descuento). El vendedor
  // ingresa un % (discountPct en el request) y el server materializa el monto
  // acá: discount = round2(subtotal * pct / 100) y totalAmount = subtotal −
  // discount (el monto FINAL). DEFAULT 0 → ventas sin descuento (backward-compat).
  discount       Float        @default(0)
  saleDate       DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoice        Invoice?
  // Puente Sale→Order: si la venta se generó procesando un pedido de la tienda
  // online, apunta a esa Order (1:1, @unique). null en ventas manuales del ERP.
  orderId        String?      @unique
  order          Order?       @relation(fields: [orderId], references: [id])
  // Branch scoping: nullable para backward-compat (existing rows = null = org-wide).
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  // Sesión de caja a la que pertenece la venta (sdd/caja-apertura-cierre R8).
  // FK nullable = backward-compat: ventas legacy/admin sin caja quedan null.
  cashSessionId  String?
  cashSession    CashSession? @relation(fields: [cashSessionId], references: [id])
  // Desglose de medios de pago (sdd/caja-apertura-cierre R6/R7/R8).
  payments       SalePayment[]

  @@index([organizationId])
  @@map("sales")
}

// Sesión de caja: una caja compartida por sucursal (branch). Tenant-scoped
// (organizationId) y en TENANT_MODELS (db.ts) → scope org automático
// anti-fuga (findFirst/updateMany, NUNCA findUnique/update). La apertura
// registra el fondo inicial; el cierre hace el arqueo comparando el conteo
// real (closingByMethod/closingAmount) contra lo esperado (expectedAmount =
// openingAmount + Σ EFECTIVO de los pagos de la sesión). La garantía de "una
// sola OPEN por sucursal (branch)" es el índice único parcial
// `cash_session_single_open` (a mano en la migración, NO regenerar).
model CashSession {
  id             String            @id @default(uuid())
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id])
  cashierId      String
  cashier        User              @relation(fields: [cashierId], references: [id])
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openingAmount  Float             @default(0)
  expectedAmount Float?
  closingAmount  Float?
  closingByMethod Json?
  status         CashSessionStatus @default(OPEN)
  observations   String?
  sales          Sale[]
  payments       SalePayment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([branchId, status])
  @@index([cashierId, status])
  @@index([organizationId])
  @@map("cash_sessions")
}

// Desglose de medios de pago de una venta (sdd/caja-apertura-cierre R6-R8).
// NO tiene organizationId propio (se scopea vía su Sale/CashSession, que sí
// son tenant models) → a propósito FUERA de TENANT_MODELS (patrón Message/
// PriceListSection). onDelete Cascade: borrar la venta borra sus pagos;
// cashSessionId onDelete SetNull: cerrar/reabrir no rompe el histórico.
model SalePayment {
  id            String        @id @default(uuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Float
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([saleId])
  @@index([cashSessionId])
  @@map("sale_payments")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // null en renglones sueltos (venta POR_PESO/POR_MONTO de una línea de la
  // planilla): el producto físico no se vende, se vende la celda (kg).
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  // Celda de la planilla "Precios por kilo" que se vendió suelta (kg). null en
  // ventas legacy BOLSA_CERRADA. onDelete SetNull: borrar la celda NO borra el
  // histórico de ventas, solo desvincula la línea (sin precio suelto asociado).
  loosePriceId String?
  loosePrice   PriceKgPrice? @relation(fields: [loosePriceId], references: [id], onDelete: SetNull)
  name      String
  // Float (sdd/venta-alimento-suelto B-03): kg decimales en venta suelta
  // (precedente: InvoiceItem.quantity Float). Las filas legacy se leen como
  // números enteros (3.0) con saleMode default BOLSA_CERRADA.
  quantity  Float
  category  String
  price     Float
  // Modo de venta del renglón: BOLSA_CERRADA (int, legacy) | POR_PESO (kg) |
  // POR_MONTO (monto → kg autoritativo en server). Default BOLSA_CERRADA:
  // las filas legacy/no-declaradas se comportan como bolsa cerrada (B-03).
  saleMode  SaleMode @default(BOLSA_CERRADA)

  @@map("sale_items")
}

enum SaleMode {
  BOLSA_CERRADA
  POR_PESO
  POR_MONTO
  // Venta de un multi-pack POR UNIDAD (sdd/venta-por-unidad-multpack): la
  // línea usa el precio por unidad derivado (round2(price/unitsPerBox)) y
  // descuenta 1 unidad de stock por unidad vendida.
  POR_UNIDAD
}

model Receipt {
  id              String       @id @default(uuid())
  type            String
  relatedDocument String
  receiptNumber   String
  createdAt       DateTime     @default(now())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("receipts")
}

// Numeración de comprobantes, ahora POR organización.
model Counter {
  id             String       @id @default(uuid())
  name           String
  sequenceValue  Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@map("counters")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum OrderType {
  SALE
  PURCHASE
}

enum OrderSource {
  STORE
  INTERNAL
  // Pedido creado al aprobar un borrador capturado por el bot de WhatsApp (FASE 3).
  WHATSAPP
}

// Estado de revisión de un borrador de pedido capturado por el bot de WhatsApp
// (FASE 3). PENDING_REVIEW = esperando que el vendedor lo arme/apruebe;
// APPROVED = se creó el Order real; REJECTED = el vendedor lo descartó.
enum WhatsAppDraftStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// Estado fiscal de una Invoice (sdd/arca-facturacion-electronica).
// PENDING_CAE: emisión fiscal en curso o fallida — correlativo reservado ANTES
// del SOAP a ARCA y datos de error (arcaErrorCode/Message) para el reintento.
// Una Invoice ISSUED sin CAE es el comprobante interno FAC-XXXX (sin valor
// fiscal); con ARCA habilitada el flujo nunca deja ISSUED sin CAE.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PENDING_CAE
  CANCELLED
}

// Ambiente ARCA (WSAA/WSFEv1). HOMOLOGACION por defecto: el comercio pasa a
// PRODUCCION solo cuando validó el alta de punto de venta y el certificado.
enum ArcaEnvironment {
  HOMOLOGACION
  PRODUCCION
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  // OPCIONAL desde sdd/arca-facturacion-electronica: la Factura B de mostrador
  // sin identificar va con DocTipo 99 / DocNro 0 (sin Customer asociado).
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  number          String? // null en DRAFT; "FAC-0001" asignado solo al ISSUED
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  items           InvoiceItem[]
  subtotal        Float         @default(0)
  taxAmount       Float         @default(0)
  totalAmount     Float         @default(0)
  status          InvoiceStatus @default(DRAFT)
  paymentStatus   PaymentStatus @default(PENDING)
  notes           String?
  // --- Fase 2 (ARCA WSFEv1), nullable, con lógica desde arca-facturacion-electronica ---
  tipoComprobante String?       // "1"=Factura A, "6"=Factura B (código ARCA)
  puntoVenta      Int?          // PV fiscal configurado en ArcaSetting
  cae             String?
  caeVencimiento  DateTime?
  // Correlativo fiscal reservado ANTES del SOAP (autoridad: FECompUltimoAutorizado).
  cbteNro                 Int?
  // Snapshot del receptor al emitir (RG 5616 / CondicionIVAReceptorId):
  docTipoReceptor         Int?    // 80=CUIT, 96=DNI, 99=Consumidor Final
  docNroReceptor          String? // "0" consumidor final; hasta 20 dígitos
  condicionIvaReceptorId  Int?    // 1=RI, 5=Consumidor Final, 6=Monotributo
  // Error de la última FECAESolicitar (para reintento y diagnóstico en UI):
  arcaErrorCode           String?
  arcaErrorMessage        String?
  arcaAttempts            Int      @default(0)
  // --- Puente Sale→Invoice (opcional; facturas de servicio no tienen venta) ---
  saleId          String?       @unique
  sale            Sale?         @relation(fields: [saleId], references: [id])
  // Sucursal emisora (sdd/sucursales-pv-facturacion). Nullable para
  // backward-compat: las facturas legacy/org-wide caen al fallback (casa
  // central / PV global de ArcaSetting). El PV efectivo se resuelve SIEMPRE
  // desde invoice.branchId (resolvePuntoVenta), nunca desde el body del issue.
  branchId        String?
  branch          Branch?       @relation("InvoiceBranch", fields: [branchId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([branchId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float   @default(21)
  lineTotal   Float // snapshot: quantity * unitPrice (sin IVA)

  @@map("invoice_items")
}

// Configuración ARCA (WSAA/WSFEv1) por organización, 1:1 con Organization
// (sdd/arca-facturacion-electronica). A PROPÓSITO fuera de TENANT_MODELS (ver
// db.ts): se accede vía basePrisma filtrando por organizationId directamente
// (mismo patrón que StoreSettings/AppBranding). Los CERTIFICADOS NUNCA se
// guardan acá: solo las rutas crt/key en el VPS (fuera del repo). `enabled`
// es el switch operativo del gate: false (default) mantiene el flujo interno
// FAC-XXXX intacto hasta que el ADMIN configura y prende ARCA por org.
model ArcaSetting {
  id             String          @id @default(uuid())
  organizationId String          @unique
  organization   Organization    @relation(fields: [organizationId], references: [id])
  // CUIT del emisor, 11 dígitos sin guiones (ej. 30709706701).
  cuitEmisor     String
  // CUIT con autorización del padrón A4 (ws_sr_padron_a4) para autocompletar
  // clientes. Difiere de cuitEmisor cuando la facturación (Don Colacho) y la
  // consulta de padrón (persona física con la autorización) usan CUITs
  // distintos. Null → cae a cuitEmisor (comportamiento previo).
  padronCuit     String?
  // Punto de venta fiscal del comercio (1..9999).
  puntoVenta     Int
  environment    ArcaEnvironment @default(HOMOLOGACION)
  // VPS: /var/www/pullstok/certs/{org}/wswfev1-{env}.crt
  certPath       String
  // VPS: /var/www/pullstok/certs/{org}/wswfev1-{env}.key
  keyPath        String
  enabled        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("arca_settings")
}

// Cache/contador local de la numeración fiscal por (org, puntoVenta,
// tipoCbte). A PROPÓSITO fuera de TENANT_MODELS (mismo criterio que Counter).
// La AUTORIDAD del número es ARCA (FECompUltimoAutorizado); esta tabla es
// cache de observación + auditoría del último correlativo reservado.
model ArcaSequence {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  puntoVenta     Int
  // "1"=Factura A, "6"=Factura B (código ARCA).
  tipoCbte       String
  lastReserved   Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, puntoVenta, tipoCbte])
  @@map("arca_sequences")
}

// Configuración de branding de la tienda online pública, 1:1 con Organization.
// A PROPÓSITO fuera de TENANT_MODELS (ver db.ts): es un modelo de fila única
// por org, se accede vía basePrisma filtrando por organizationId directamente
// (no necesita el scope automático de la extensión multi-tenant).
model StoreSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  primaryColor   String       @default("#111827")
  logoUrl        String?
  bannerUrl      String?
  tagline        String?
  showNewsletter Boolean      @default(true)
  showBanner     Boolean      @default(true)
  // Badges configurables de confianza (envío gratis, garantía, etc.). Array
  // de hasta 3 objetos { title, subtitle } — NO hardcodeado, NO reviews/stars
  // (no tenemos backend para eso). El storefront solo muestra la barra si
  // este campo no es null/vacío.
  badges         Json?
  contactEmail   String?
  contactPhone   String?
  address        String?
  // Tienda online publicada (switch del admin): false = borrador, la tienda
  // pública no sirve catálogo, detalle ni checkout (403 STORE_NOT_PUBLISHED).
  isPublished    Boolean      @default(false)
  // Sucursal que alimenta la tienda online (spec S1): catálogo/detalle/checkout
  // leen ProductStock de esta sucursal en vez del stock global. null = sin
  // configurar → fallback a la casa central (resolveEffectiveBranch). FK con
  // onDelete SetNull: si borran la sucursal, la tienda cae sola al fallback HQ
  // sin dejar estado inválido (decisión D6 del design).
  storeBranchId  String?
  storeBranch    Branch?        @relation(fields: [storeBranchId], references: [id], onDelete: SetNull)
  updatedAt      DateTime       @updatedAt

  @@map("store_settings")
}

// ---------------------------------------------------------------------------
// Chat cliente↔operador (FASE A: cimiento de datos)
// ---------------------------------------------------------------------------

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageSender {
  GUEST
  OPERATOR
}

// Modo de atención de una conversación. En FASE 1, el bot (Groq) responde SOLO
// si mode=BOT. La FASE 2 (handoff a humano) flipeará a HUMAN cuando un operador
// tome la conversación, silenciando al bot. Default BOT: toda conversación nueva
// arranca atendida por el bot (si la org lo tiene habilitado).
enum ConversationMode {
  BOT
  HUMAN
}

// Canal de origen de la conversación: WEB (widget tienda) | WHATSAPP (Kapso).
// Default WEB para que las conversaciones existentes no cambien de comportamiento.
enum ConversationChannel {
  WEB
  WHATSAPP
}

// Una conversación de chat entre un visitante (guest) de la tienda pública y
// los operadores del comercio. Es tenant-scoped (organizationId): pertenece a
// la org y está en TENANT_MODELS (db.ts) → scope automático anti-fuga en los
// endpoints del operador. El guest se identifica por nombre/email (sin cuenta);
// si el email matchea un Customer de la org, se linkea vía customerId.
model Conversation {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  guestName      String
  guestEmail     String
  // Link opcional al Customer de la org cuando el email matchea. No es FK
  // obligatoria: un visitante puede escribir sin haber comprado nunca.
  customerId     String?
  customer       Customer?          @relation(fields: [customerId], references: [id])
  // Canal de origen de la conversación: WEB (widget tienda) | WHATSAPP (Kapso).
  // Default WEB para que las conversaciones existentes no cambien de comportamiento.
  channel        ConversationChannel @default(WEB)
  // Identidad del cliente por WhatsApp (E.164 sin espacios/+). Null en canal WEB.
  guestPhone     String?
  status         ConversationStatus @default(OPEN)
  // Modo de atención (FASE 1 bot IA): BOT = el asistente Groq responde
  // automáticamente; HUMAN = lo atiende un operador (handoff de FASE 2). Default
  // BOT para que el bot responda desde el primer mensaje si la org lo habilitó.
  mode           ConversationMode   @default(BOT)
  // Handoff a humano (FASE 2): timestamp del momento en que la conversación se
  // escaló de BOT a HUMAN (por botón del widget o porque el bot lo detectó).
  // Null = nunca escalada. Al escalar se setea mode=HUMAN + escalatedAt=now.
  escalatedAt    DateTime?
  // Nodo actual del flujo de WhatsApp (FASE 2). Null = no está en un flujo
  // guiado de pedido. Valores en whatsappFlow (constantes de string, no enum,
  // para no migrar por cada nodo nuevo).
  whatsappStage  String?
  // Acumulador JSON del borrador de pedido (FASE 3): guarda por mensaje el dato
  // que el cliente aporta (orderType, productText, address, paymentMethod...)
  // para, al llegar a un estado terminal, crear el WhatsAppOrderDraft sin
  // re-parsear la conversación. Null hasta que el bot captura algún dato.
  whatsappDraftData Json?
  // Timestamp del último mensaje (para ordenar la bandeja del operador). Null
  // hasta que se escribe el primer mensaje.
  lastMessageAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  messages       Message[]
  whatsAppOrderDrafts WhatsAppOrderDraft[]

  @@index([organizationId, lastMessageAt])
  @@index([organizationId, channel, guestPhone])
  @@map("conversations")
}

// Un mensaje dentro de una conversación. NO tiene organizationId propio (se
// scopea vía la Conversation, que sí es tenant-model) → a propósito FUERA de
// TENANT_MODELS. onDelete Cascade: borrar la conversación borra sus mensajes.
model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  // Id del User operador cuando sender=OPERATOR; null cuando sender=GUEST.
  senderUserId   String?
  // true si la respuesta la generó el bot IA (Groq). Nace como sender=OPERATOR
  // con senderUserId=null e isBot=true → la UI del operador puede distinguir una
  // respuesta del bot de la de un humano. Default false: todo mensaje humano.
  isBot          Boolean       @default(false)
  body           String
  // Marca de lectura (para el contador de no-leídos del operador). Los mensajes
  // del GUEST arrancan readAt=null hasta que el operador los lee.
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Bot de atención IA (FASE 1: motor Groq)
// ---------------------------------------------------------------------------

// Configuración del bot por comercio (1:1 con Organization). Es tenant-scoped
// (organizationId @unique) y está en TENANT_MODELS (db.ts) → scope automático
// anti-fuga en los endpoints del operador (FASE 2). El bot responde en el chat
// cliente↔operador cuando enabled=true y la conversación está en mode=BOT.
model BotConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Interruptor maestro: si false, el bot no responde nunca para esta org.
  enabled        Boolean      @default(false)
  // Base de conocimiento que el dueño escribe (info del negocio: horarios,
  // envíos, políticas, catálogo, etc.). Se inyecta como contexto en el system
  // prompt (truncada a un cap de caracteres). Default vacío.
  knowledgeBase  String       @default("")
  // Modelo Groq a usar (configurable por comercio). Default: modelo chico y
  // barato de Groq. Ver generateBotReply en botService.
  model          String       @default("llama-3.1-8b-instant")
  // Placeholder para BYO-key (bring-your-own-key): cuando se implemente, ENCRIPTAR
  // antes de guardar. HOY nadie la usa: resolveGroqKey siempre cae en la key de
  // plataforma (env GROQ_API_KEY). Nullable a propósito.
  apiKey         String?
  // Freno de costo: máximo de respuestas del bot por día para esta org. Al
  // llegar al tope, el bot queda en silencio el resto del día (ver botService).
  dailyLimit     Int          @default(200)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("bot_configs")
}

// ---------------------------------------------------------------------------
// Borrador de pedido capturado por el bot de WhatsApp (FASE 3)
// ---------------------------------------------------------------------------

// Borrador de pedido que el bot arma durante el flujo guiado (FASE 2) y que el
// vendedor aprueba desde el ERP para crear el pedido real. Guarda lo que el
// cliente dijo en texto libre (producto, dirección, pago) + el Customer linkeado
// si el phone matcheó. Tenant-scoped (organizationId) → en TENANT_MODELS (db.ts)
// → scope org automático anti-fuga (findFirst/updateMany, nunca findUnique).
// El pedido real (Order) se crea en approveDraft; el borrador pasa a APPROVED y
// queda linkeado vía orderId. `amount` (por monto) y `quantityKg` (por kilo)
// quedan null en FASE 2 (el flujo no los pide todavía); la rama de cálculo es
// FASE 4. `orderType` se normaliza a minúscula: "bolsa" | "kilo" | "monto" |
// "otro"; `paymentMethod` a "qr" | "transferencia" | "efectivo".
model WhatsAppOrderDraft {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  phone          String
  contactName    String?
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id])
  orderType      String            @default("otro")
  productText    String?
  quantityKg     Float?
  amount         Float?
  address        String?
  paymentMethod  String            @default("efectivo")
  // FASE 6 — multi-producto + observación. `items` es el array JSON de líneas del
  // pedido (cada línea: productId, productName, type, quantity, amount, detail,
  // total, marca, especie, etapa, peso, observacion). `notes` es la observación
  // libre del pedido (null si el cliente respondió "no" / vacío).
  items          Json?
  notes          String?
  status         WhatsAppDraftStatus @default(PENDING_REVIEW)
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, status, createdAt])
  @@map("whatsapp_order_drafts")
}

// Configuración de branding del ERP por organización, 1:1 con Organization.
// A PROPÓSITO fuera de TENANT_MODELS (ver db.ts): se accede vía basePrisma
// filtrando por organizationId directamente (mismo patrón que StoreSettings).
model AppBranding {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  primaryColor   String       @default("#111827")
  logoUrl        String?
  faviconUrl     String?
  displayName    String?
  showDisplayName Boolean      @default(true)
  updatedAt      DateTime     @updatedAt

  @@map("app_branding")
}

// Configuración de horario comercial por organización, 1:1 con Organization.
// A PROPÓSITO fuera de TENANT_MODELS (ver db.ts): se accede vía basePrisma
// filtrando por organizationId directamente (mismo patrón que StoreSettings).
// `days` es un Json con 7 entradas { day: 0(domingo)..6(sábado), enabled,
// open: "HH:MM", close: "HH:MM" }. Sin fila = sin restricción (backwards
// compatible: el gate de business-hours solo se activa cuando un ADMIN guarda
// la config por primera vez).
model BusinessHourSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  timezone       String       @default("America/Argentina/Buenos_Aires")
  days           Json
  updatedAt      DateTime     @updatedAt

  @@map("business_hour_settings")
}

// Configuración de precios de la org, 1:1 con Organization
// (sdd/venta-alimento-suelto B-02). A PROPÓSITO fuera de TENANT_MODELS (ver
// db.ts): se accede vía basePrisma filtrando por organizationId directamente
// (mismo patrón que AppBranding / StoreSettings / BusinessHourSetting).
// Sin fila = default 1.20 (la GET devuelve el default sin crear nada; la PUT
// hace upsert). Los productos con bulkFactor propio NO se tocan al guardar el
// factor org (recompute WHERE bulkFactor IS NULL — B-05a).
model PricingSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Factor mayorista default de la org: priceKgSuelto = round2(price/weightKg
  // × bulkFactor). El ADMIN lo edita desde "Configuración de precios"
  // (A-01); nunca hardcodeado en el código.
  bulkFactor     Float        @default(1.20)
  updatedAt      DateTime     @updatedAt

  @@map("pricing_settings")
}

// ---------------------------------------------------------------------------
// Planillas de precios de proveedor (sdd/alican-wholesale-price-list)
// ---------------------------------------------------------------------------

// Una planilla importada del PDF Alican (SECO/WET). Idempotencia (D1/D2):
// una planilla por (org, type, period); re-importar el MISMO período borra y
// recrea la misma fila (cascade a sections/entries). El índice único ES
// parcial (WHERE period IS NOT NULL) — ver la migración: period null (PDF sin
// vigencia) crea fila nueva en cada import (Postgres trata NULLs como
// distintos).
model PriceList {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  provider       String             @default("ALICAN")
  type           PriceListType
  // Vigencia del PDF normalizada a YYYY-MM-DD; null si el header no la trae.
  period         String?
  sourceFilename String             // nombre ORIGINAL del PDF (metadata)
  importedAt     DateTime           @default(now())
  sections       PriceListSection[]

  @@unique([organizationId, type, period])
  @@index([organizationId, importedAt])
  @@map("price_lists")
}

// Sección de la jerarquía DEL PDF (marca → línea → sublínea), no las
// categorías del sistema. Sin organizationId propio (patrón Message, D4): se
// scopea vía su PriceList (resuelto siempre con findFirst + organizationId).
model PriceListSection {
  id          String           @id @default(uuid())
  priceListId String
  priceList   PriceList        @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  brand       String?          // marca DEL PDF (no la variante del sistema)
  line        String?          // ej. "SUPER PREMIUM PARA PERROS" (sin prefijo "LÍNEA")
  subline     String?          // ej. "SIEGER PUPPY"
  position    Int              // orden de aparición en el PDF
  entries     PriceListEntry[]

  @@index([priceListId, position])
  @@map("price_list_sections")
}

// Fila de producto de la planilla. productId null = la fila no se matcheó
// (las filas omitidas en el preview NO se persisten). priceConIva es SOLO
// informativo (nunca toca product.price). suggestedPrice se persiste acá Y en
// Product.suggestedPrice para los productos matcheados.
model PriceListEntry {
  id             String            @id @default(uuid())
  sectionId      String
  section        PriceListSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?          @relation(fields: [productId], references: [id])
  name           String            // nombre ORIGINAL del PDF
  unit           String?           // unidad de empaque ("1 Kg.", "12 pouches x 100 gr")
  priceSinIva    Decimal?          @db.Decimal(12, 2)
  priceConIva    Decimal?          @db.Decimal(12, 2) // informativo; NUNCA toca product.price
  suggestedPrice Decimal?          @db.Decimal(12, 2)
  matched        Boolean           @default(false)
  position       Int               // orden dentro de la sección

  @@index([sectionId, position])
  @@map("price_list_entries")
}
